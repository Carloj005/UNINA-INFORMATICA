# .gitignore globale per UNINA-INFORMATICA

# Metadati IDE, Editor e Sistema Operativo
.project
.classpath
.settings/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# File temporanei di compilazione (C/C++, Java, Python, Node)
bin/
obj/
build/
target/
.gradle/
node_modules/
.venv/
venv/
*.class
*.jar
*.exe
*.out
*.o
*.a
*.so
*.dylib
*.dll
*.pyc
__pycache__/

# File temporanei LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.snm
*.synctex.gz
*.toc
*.vrb

# Build locale sito web statico
_site/

# Documenti temporanei
~$*
*.log
*.tmp
*.bak
